{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignoreDeps": ["javaBin/platform"],
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "terraform/ is generated by the javaBin platform from app.yaml and overwritten on every deploy",
      "matchFileNames": ["terraform/**"],
      "enabled": false
    },
    {
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Must match minimumReleaseAge (4320 minutes) in pnpm-workspace.yaml",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/Dockerfile/"],
      "matchStrings": ["npm install -g pnpm@(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ]
}
