{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignoreDeps": ["javaBin/platform"],
  "packageRules": [
    {
      "description": "terraform/ is generated by the javaBin platform from app.yaml and overwritten on every deploy",
      "matchFileNames": ["terraform/**"],
      "enabled": false
    },
    {
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm",
      "minimumReleaseAge": "24 hours"
    },
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "24 hours"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["Dockerfile"],
      "matchStrings": ["npm install -g pnpm@(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ]
}
